[Setup]
	AppName=Gitview
	AppVersion=@PROJECT_VERSION@
	AppPublisher=Quin Gillespie
	AppPublisherURL=https://github.com/accessware/gitview
	AppSupportURL=https://github.com/accessware/gitview/issues
	AppUpdatesURL=https://github.com/accessware/gitview/releases
	DefaultDirName={autopf}\Gitview
	DisableProgramGroupPage=yes
	DisableDirPage=yes
	OutputDir=.
	OutputBaseFilename=gitview_setup-@ARCH_SUFFIX@
	Compression=lzma2
	SolidCompression=yes
	WizardStyle=modern
	UninstallDisplayIcon={app}\gitview.exe
	ArchitecturesAllowed=@ARCH_ALLOWED@
	ArchitecturesInstallIn64BitMode=@ARCH_MODE@

[Languages]
	Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
	Source: "gitview.exe"; DestDir: "{app}"; Flags: ignoreversion
	Source: "readme.html"; DestDir: "{app}"; Flags: ignoreversion

[Tasks]
	Name: "desktopicon"; Description: "Desktop Shortcut"
	Name: "startmenuicon"; Description: "Start Menu Shortcut"; Flags: unchecked

[Icons]
	Name: "{autodesktop}\Gitview"; Filename: "{app}\gitview.exe"; Tasks: desktopicon
	Name: "{autoprograms}\Gitview"; Filename: "{app}\gitview.exe"; Tasks: startmenuicon

[Run]
	Filename: "{app}\gitview.exe"; Description: "Launch Gitview"; Flags: nowait postinstall skipifsilent
	Filename: "{app}\readme.html"; Description: "View readme.html"; Flags: shellexec postinstall skipifsilent unchecked
